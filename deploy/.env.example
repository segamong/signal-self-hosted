# Use generate-env.mjs to create real random secrets; this file is documentation.
# TLS_MODE=ip uses a Let's Encrypt short-lived IP certificate; no domains required.
# Domains in domain mode must be YOUR domains with direct A records to YOUR IPv4.
TLS_MODE=domain
APP_DOMAIN=chat.example.com
RTC_DOMAIN=rtc.example.com
SERVER_IP=203.0.113.10
ACME_EMAIL=admin@example.com
HTTPS_PORT=8443
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_WITH_SCRIPT
LIVEKIT_API_KEY=GENERATE_WITH_SCRIPT
LIVEKIT_API_SECRET=GENERATE_WITH_SCRIPT
# Optional embedded TURN/UDP only. It does not provide TURN/TLS on port 443.
TURN_ENABLED=false
