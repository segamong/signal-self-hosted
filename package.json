{
  "name": "signal-self-hosted",
  "version": "0.6.0",
  "description": "Сигнал — общение на своём сервере",
  "author": "Signal Community",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "desktop:build": "pnpm build && electron-builder --win --x64 --config electron-builder.yml"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "express": "5.3.0",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "packageManager": "pnpm@11.25.0"
}
